# Exhaustiveness: the summary block must be EXACTLY this. Any extra
# application section or changed resource fails here rather than being
# quietly pinned by the next --regenerate.
expect:affected=1 changed=0 errors=1
# app-level render errors are REPORT content, not process failure
must:# Error: failed to render target branch
must:unexpected \{\{end\}\}
must:# Applications changed: 0
