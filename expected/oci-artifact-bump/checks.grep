# Exhaustiveness: the summary block must be EXACTLY this. Any extra
# application section or changed resource fails here rather than being
# quietly pinned by the next --regenerate.
expect:affected=2 changed=2 resources=+0,-0,~3
# the CR's revision, then the artifact that revision pulled
must:^\+        targetRevision: 6\.7\.1
must:podinfo:6\.7\.1
# the source really is the ARTIFACT spelling: the scheme and the chart name both
# ride in repoURL, and no chart: field exists. Without this the case could be
# silently respelled into a duplicate of oci-chart-bump.
must:repoURL: oci://ghcr\.io/stefanprodan/charts/podinfo
must-not:^[ +-] +chart: podinfo$
